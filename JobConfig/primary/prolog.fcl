#
# Prolog to create signal, signal-like, or calibration particles, producing subsequent detector steps
#
#include "Offline/TrackerMC/fcl/prolog.fcl"
#include "Offline/CaloMC/fcl/prolog.fcl"
#include "Offline/CRVResponse/fcl/prolog.fcl"
#include "Offline/Filters/fcl/prolog.fcl"
#include "Offline/Compression/fcl/prolog.fcl"
#include "Offline/CommonMC/fcl/prolog.fcl"
#include "Offline/EventGenerator/fcl/prolog.fcl"
BEGIN_PROLOG

# One line to enable stage normalization on a resampling primary, naming the
# pool's own counter, e.g.
#
#   physics.filters.TargetStopResampler.mu2e.products.stageNormMixer : @local::PrimaryStageNorm.fromTargetStops
#
# Not on by default -- see the note in pileup/prolog.fcl.
PrimaryStageNorm : {
  # A primary resamples MuminusStopsCat / MuplusStopsCat, which the stop
  # selectors make from the target-stop stream 1:1 -- so the label is the
  # SELECTOR's counter. Naming targetStopCounter instead would use the count of
  # every target stop rather than the selected ones: 79203/79278 for mu- in
  # Run1B, and 75/79278 for mu+, a factor of about 1000.
  fromMuminusStops  : { moduleLabel : "muminusStopCounter" srOutInstance : "resampled" }
  fromMuplusStops   : { moduleLabel : "muplusStopCounter"  srOutInstance : "resampled" }
  fromPolyMuminusStops : { moduleLabel : "polyMuminusStopCounter" srOutInstance : "resampled" }
  fromPolyMuplusStops  : { moduleLabel : "polyMuplusStopCounter"  srOutInstance : "resampled" }
  fromIPAMuminusStops  : { moduleLabel : "ipaMuminusStopCounter"  srOutInstance : "resampled" }
  fromIPAMuplusStops   : { moduleLabel : "ipaMuplusStopCounter"   srOutInstance : "resampled" }
  fromPiminusStops     : { moduleLabel : "piminusStopCounter"     srOutInstance : "resampled" }
  fromPiplusStops      : { moduleLabel : "piplusStopCounter"      srOutInstance : "resampled" }
  fromPolyPiminusStops : { moduleLabel : "polyPiminusStopCounter" srOutInstance : "resampled" }
  fromPolyPiplusStops  : { moduleLabel : "polyPiplusStopCounter"  srOutInstance : "resampled" }
  # Only for a pool taken straight from the pileup stage with no selector.
  fromTargetStops   : { moduleLabel : "targetStopCounter"   srOutInstance : "resampled" }
  fromTargetPiStops : { moduleLabel : "targetPiStopCounter" srOutInstance : "resampled" }
  fromPolyPiStops   : { moduleLabel : "polyPiStopCounter"   srOutInstance : "resampled" }
  fromIPAStops      : { moduleLabel : "IPAStopCounter"      srOutInstance : "resampled" }
  fromTargetGammas  : { moduleLabel : "targetGammaCounter"  srOutInstance : "resampled" }
  fromWireGammas    : { moduleLabel : "wireGammaCounter"    srOutInstance : "resampled" }
  fromIPAGammas     : { moduleLabel : "ipaGammaCounter"     srOutInstance : "resampled" }
}

Primary: {
  producers : {

    # End of PrimaryPath: counts what the primary output keeps, against the
    # normalization TargetStopResampler carried through from the pileup stage.
    # upstreamTag, not genCountTag -- this is a resampling stage, so the job's
    # own GenEventCount counts draws.
    primaryCounter : {
      module_type : StageNormalizationCounter
      upstreamTag : "TargetStopResampler:resampled"
        required    : false
    }
    # Same job for primaries starting from other beam inputs: the counter must
    # name the resampler that stage actually runs, since that is what carried
    # the normalization through.
    primaryPiStopCounter : {
      module_type : StageNormalizationCounter
      upstreamTag : "TargetPiStopResampler:resampled"
        required    : false
    }
    primaryIPAStopCounter : {
      module_type : StageNormalizationCounter
      upstreamTag : "IPAMuminusStopResampler:resampled"
        required    : false
    }
    primaryGammaCounter : {
      module_type : StageNormalizationCounter
      upstreamTag : "GammaConversionResampler:resampled"
        required    : false
    }
    # RMCGammaStops writes three gamma pools from one resampling job, so each
    # gets its own counter -- the streams have different efficiencies and a
    # conversion stage must name the pool it actually resamples.
    targetGammaCounter : {
      module_type : StageNormalizationCounter
      upstreamTag : "TargetStopResampler:resampled"
        required    : false
    }
    wireGammaCounter : {
      module_type : StageNormalizationCounter
      upstreamTag : "TargetStopResampler:resampled"
        required    : false
    }
    ipaGammaCounter : {
      module_type : StageNormalizationCounter
      upstreamTag : "TargetStopResampler:resampled"
        required    : false
    }

    @table::TrackerMC.StepProducers
    @table::CaloMC.producers
    CrvSteps :{
      @table::CrvSteps
      stepPointsModuleLabels : ["g4run"]
    }
    MakeSS : {
      @table::CommonMC.MakeSS
      VDStepPointMCs : "g4run:virtualdetector"
      AbsorberStepPointMCs : "g4run:protonabsorber"
      TargetStepPointMCs : "g4run:stoppingtarget"
    }
    compressDetStepMCs : {
      module_type : CompressDetStepMCs
      strawGasStepTag : "StrawGasStepMaker"
      caloShowerStepTag : "CaloShowerStepMaker"
      crvStepTag : "CrvSteps"
      surfaceStepTag : "MakeSS"
      simParticleTags : [ "g4run" ]
      mcTrajectoryTag : "g4run"
      debugLevel : 0
      # save StepPoints in VDs
      stepPointMCTags : [ "g4run:virtualdetector"]
      compressionOptions : @local::DetStepCompression.standardCompression
    }
    FindMCPrimary : {
      module_type : FindMCPrimary
      SimParticles : "compressDetStepMCs"
    }
    # null MCPrimary, for NoPrimary events
    NullMCPrimary : {
      module_type: NullMCPrimary
      ExtraSteps : [ "virtualdetector", "stoppingtarget", "protonabsorber" ] # these will be created but empty
    }
  }

  filters : {
    # basic step filter configuration: these can get refined for particular primaries

    # step filter for signal-like or calibration particles.  This gets customized by downstream scripts
    PrimaryFilter : {
      module_type : DetectorStepFilter
      StrawGasSteps : [ "StrawGasStepMaker" ]
      CaloShowerSteps : [ "CaloShowerStepMaker" ]
      CrvSteps : [ ] # dont filter on CRV since that can't trigger
      MinimumTrkStepEnergy : 1.0e-6 # 1 ev
      MinimumCaloStepEnergy : 0.0
      MinimumCrvStepEnergy : 0.1
      MinimumCrvSteps : 1
      MinimumPartMom : 50.0 # MeV/c
      MaximumPartMom : 1.0e6 # MeV/c
      MinimumCaloPartMom : 0.0 # MeV
      MaximumCaloPartMom : 1.0e6 # MeV
      KeepPDG : [ ] # Loop at steps from all particle types
      MinimumTrkSteps : 12 # primary must produce at least this many TrkSteps
      MinimumSumCaloStepE : 45.0 # or at least this much calo energy by a single sim particle
      MinimumSumCaloE : 45.0 # or at least this much calo total energy by accepted sim particles
    }

    TargetStopResampler : {
      module_type: ResamplingMixer
      readMode            : sequential
      wrapFiles           : true
      fileNames: @nil
      mu2e: {
        writeEventIDs : true
        MaxEventsToSkip: @nil
        debugLevel : 0
        products: {
          genParticleMixer: { mixingMap: [ [ "beamResampler", "" ] ] }
          simParticleMixer: { mixingMap: [ [ "TargetStopFilter", "" ] ] }
          stepPointMCMixer: { mixingMap: [ [ "TargetStopFilter:virtualdetector", ":" ] ] }
          volumeInfoMixer: {
            srInput: "compressPVTargetStops"
            evtOutInstanceName: "eventlevel"
          }
        }
      }
    }

    TargetPiStopResampler : {
      module_type: ResamplingMixer
      readMode            : sequential
      wrapFiles           : true
      fileNames: @nil
      mu2e: {
        writeEventIDs : true
        MaxEventsToSkip: @nil
        debugLevel : 0
        products: {
          genParticleMixer: { mixingMap: [ [ "beamResampler", "" ] ] }
          simParticleMixer: { mixingMap: [ [ "TargetPiStopFilter", "" ] ] }
          stepPointMCMixer: { mixingMap: [ [ "TargetPiStopFilter:virtualdetector", ":" ] ] }
          volumeInfoMixer: {
            srInput: "compressPVTargetPiStops"
            evtOutInstanceName: "eventlevel"
          }
        }
      }
    }

    IPAMuminusStopResampler : {
      module_type: ResamplingMixer
      readMode            : sequential
      wrapFiles           : true
      fileNames: @nil
      mu2e: {
        writeEventIDs : true
        MaxEventsToSkip: @nil
        debugLevel : 0
        products: {
          genParticleMixer: { mixingMap: [ [ "beamResampler", "" ] ] }
          simParticleMixer: { mixingMap: [ [ "IPAStopFilter", "" ] ] }
          stepPointMCMixer: { mixingMap: [ [ "IPAStopFilter:virtualdetector", ":" ] ] }
          volumeInfoMixer: {
            srInput: "compressPVIPAStops"
            evtOutInstanceName: "eventlevel"
          }
        }
      }
    }

    GammaConversionResampler : {
      module_type: ResamplingMixer
      readMode            : sequential
      wrapFiles           : true
      fileNames: @nil
      mu2e: {
        writeEventIDs : true
        MaxEventsToSkip: @nil
        debugLevel : 0
        products: {
          genParticleMixer: { mixingMap: [ [ "TargetStopResampler", "" ] ] }
          simParticleMixer: { mixingMap: [ [ "GammasFilter", "" ] ] }
          stepPointMCMixer: { mixingMap: [ [ "GammasFilter:virtualdetector", ":" ] ] }
          volumeInfoMixer: {
            srInput: "compressGammas"
            evtOutInstanceName: "eventlevel"
          }
        }
      }
    }

    StopSelector : { module_type : NullProducer }

    GammaConversionFilter : {
      module_type : GammaConversionPoints
      g4ModuleLabel : "g4run"
      doFilter : true
      rMin : 0.   # Include target and IPA
      rMax : 500.
      zMin : 5000.
      zMax : 8000.
      eMin : 1.5
      verbosity : 0
      saveTree : false
    }
  }

  # sequence to create DetectorSteps
  DetStepSequence : [
    @sequence::TrackerMC.StepSim,
    @sequence::CaloMC.StepSim,
    CrvSteps,
    MakeSS ]
  # sequence to finalize the output
  FinalizeSequence : [  compressDetStepMCs, FindMCPrimary ]

  GeneralProducts: [
    "keep mu2e::StatusG4_*_*_*",
    "keep mu2e::GenEventCount_*_*_*" ,
    "keep art::EventIDs_*_*_*", # these are the original eventids prior to resampling
    "keep mu2e::CosmicLivetime_*_*_*",
    # The same job as CosmicLivetime above, for the rest of the chain: what
    # this stream's events represent at the origin. Dropping it here loses the
    # only in-file record, and everything downstream inherits the loss.
    "keep mu2e::StageNormalization_*_*_*",
    "keep mu2e::EventWeight_*_*_*",
    "keep art::TriggerResults_*_*_*",
    "keep mu2e::StepPointMCs_CosmicResampler_crvStage1_*", # this is needed to keep track of low/all CRV split
    "keep mu2e::PrimaryParticle_*_*_*",
    "keep mu2e::SpectrumConfig_*_*_*"
  ]

  StepProducts : [
    "keep *_compressDetStepMCs_*_*"
  ]

  analyzers: {
    genCountLogger: { module_type: GenEventCountReader makeHistograms: false }
  }

  PrimaryOutput : {
    module_type : RootOutput
    SelectEvents : [ PrimaryPath ]
    fileName    : @nil
  }
  EndSequence : [ genCountLogger ]
}

# RMC information
RMCInfo : {
  kmaxMeasured : 90.1 # Measured as 90.1 +- 1.8
  kmaxEndpoint : 101.9 # Maximum photon kinematically allowed on aluminum
}

# RPC information
RPCInfo : {
    minPionStopTime  : 350. # minimum pion stop time considered, in ns
    pionStoppingCode : 78 # hBertiniCaptureAtRest
    # pi- p -> n gamma at rest (COL5 poly hydrogen captures): a single line at
    # (s - m_n^2)/(2 sqrt(s)), sqrt(s) = m_pi + m_p
    hydrogenCaptureSpectrum : {
      spectrumShape : monoenergetic
      ehi           : 129.4 # MeV
    }
}

StopFilter : {

  filters : {
    @table::genFilters.filters
  }

  KeptProducts : ["keep mu2e::*_*_*_*"]

  analyzers: {
    genCountLogger: { module_type: GenEventCountReader makeHistograms: false }
  }
  StopFilterOutput : {
    module_type : RootOutput
    SelectEvents : [ StopFilterPath ]
    fileName    : @nil
  }

  EndSequence : [genCountLogger ]
}
# define the main sequence
StopFilter.StopFilterOutput.outputCommands : [ "drop *_*_*_*", @sequence::StopFilter.KeptProducts]
StopFilter.EndPath : [ StopFilterOutput ]


# define the main sequence
Primary.PrimarySequence : [ @sequence::Primary.DetStepSequence, PrimaryFilter, @sequence::Primary.FinalizeSequence ]
Primary.PrimaryOutput.outputCommands : [ "drop *_*_*_*",
  @sequence::Primary.GeneralProducts,
  @sequence::Primary.StepProducts
]
Primary.EndPath : [ @sequence::Primary.EndSequence, PrimaryOutput ]
END_PROLOG
