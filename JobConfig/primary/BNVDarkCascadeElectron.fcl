#
# Original author: Michael MacKenzie, 2026
#
#include "Production/JobConfig/primary/BNVMuonCapture.fcl"

physics.producers.generate.decayProducts : @local::BNVMuonCapture.DarkCascadeElectron
outputs.PrimaryOutput.fileName : "dts.owner.BNVDarkCascadeElectron.version.sequencer.art"
