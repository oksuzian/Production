# Filter Muminus and Muplus COL5 poly stops from combined stops and write them to a file

#include "Production/JobConfig/pileup/MuonStopSelector.fcl"

physics.filters.muminusSelector.SimParticles : "PolyStopFilter"
physics.filters.muplusSelector.SimParticles  : "PolyStopFilter"
outputs.muminusout.fileName : "sim.owner.MuminusPolyStopsCat.version.sequencer.art"
outputs.muplusout.fileName  : "sim.owner.MuplusPolyStopsCat.version.sequencer.art"

# This selects from the POLY stop stream, not the target one, so the counters
# count against polyStopCounter, under the labels PrimaryStageNorm expects for
# a poly pool (fromPolyMuminusStops / fromPolyMuplusStops).
physics.producers.polyMuminusStopCounter : { module_type : StageNormalizationCounter
                        upstreamTag : "polyStopCounter"
                        required    : false }
physics.producers.polyMuplusStopCounter : { module_type : StageNormalizationCounter
                        upstreamTag : "polyStopCounter"
                        required    : false }
physics.producers.muminusStopCounter : @erase
physics.producers.muplusStopCounter  : @erase
physics.selectMuminus : [muminusSelector, polyMuminusStopCounter]
physics.selectMuplus  : [muplusSelector,  polyMuplusStopCounter]
