#
# Extracted-geometry cosmic reconstruction for nightly validation: runs the KinematicLine fit (KKLine) and its
# extrapolation to the CRV sectors.
#
#include "Production/JobConfig/recoMC/Extracted.fcl"
#include "Production/Validation/database.fcl"
